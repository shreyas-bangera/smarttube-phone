<?xml version="1.0" encoding="utf-8"?>
<!-- Phone build overlay: merged on top of src/main/AndroidManifest.xml for the stphone flavor. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="com.liskovsoft.smartyoutubetv2.tv">

    <!-- Phones are not leanback devices. Keep the TV feature optional so stores and installers treat this as a phone app. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"
        tools:replace="android:required" />

    <!-- Settings, Check for updates: installs new releases from GitHub -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Permissions the TV app uses and the phone app never does. Removed from the phone build: together they read like
         the profile of harmful software (draw over other apps, start at boot, delete apps, microphone, privileged
         phone state), and Play Protect blocks such apps when they are installed from outside the Play Store.
         Voice search uses Android's own speech screen, which needs no microphone permission. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.ACTION_MANAGE_OVERLAY_PERMISSION" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.QUICKBOOT_POWERON" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />

    <!-- More TV-only leftovers, none used by the phone app:
         the local network discovery of "Remote control" (cast target), the Bluetooth name it announced itself with,
         Android TV's programme guide (home screen rows) and the permission guarding its search provider -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" tools:node="remove" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" tools:node="remove" />
    <uses-permission android:name="${applicationId}.ACCESS_VIDEO_DATA" tools:node="remove" />
    <permission android:name="${applicationId}.ACCESS_VIDEO_DATA" tools:node="remove" />
    <uses-feature android:name="android.hardware.microphone" tools:node="remove" />

    <!-- Browsing uses the phone UI in portrait. The remaining Leanback screens (player, sign-in) stay landscape. -->
    <application
        android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneApplication"
        tools:replace="android:name">

        <!-- Phone UI: portrait screens driven by SmartTube's existing presenters -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneBrowseActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneSearchActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <!-- Menus as phone bottom sheets -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneDialogActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:screenOrientation="unspecified"
            android:theme="@style/PhoneSheetTheme"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Home and the player are singleTop (opened with CLEAR_TOP or REORDER_TO_FRONT, see PhoneApplication): the
             player can wait behind the app while its video plays in the mini player card.
             Player: same task as the rest of the app (one card in recents). Picture-in-picture moves it to its own window.
             Not shown over the lock screen: locking the phone locks it, the video keeps playing in the background and
             the lock screen shows its media controls. -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhonePlaybackActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            android:showWhenLocked="false"
            android:turnScreenOn="false"
            android:supportsPictureInPicture="true"
            android:theme="@style/App.Theme.Leanback.Player" />
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneSignInActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneChannelActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneChannelUploadsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- Launcher activity: portrait, and the app shortcuts (long press the icon) -->
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity" android:screenOrientation="portrait" tools:replace="android:screenOrientation">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/phone_shortcuts" />
        </activity>
        <!-- The TV screens and the TV launcher's entry points. The phone has its own screen for each of them (see
             PhoneApplication) and nothing opens these, so they are left out of the phone build. The one TV screen still
             used is the web browser (links from settings pages). -->
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.browse.BrowseActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.channel.ChannelActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.channeluploads.ChannelUploadsActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.playback.PlaybackActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.search.tags.SearchTagsActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.signin.SignInActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.adddevice.AddDeviceActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.webbrowser.WebBrowserActivity" android:screenOrientation="sensorLandscape" tools:replace="android:screenOrientation"/>
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.dialogs.AppDialogActivityOpaque" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.HomeLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.NewsLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.MusicLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.GamesLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.ChannelsLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.SubscriptionsLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.HistoryLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.PlaylistsLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.SearchLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.dialogs.AppDialogActivity" tools:node="remove" />
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneUpdateActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <!-- Notifications tab: new videos from subscribed channels -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneNotificationsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <!-- You > Downloads, and the in-app player for downloaded files -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneDownloadsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneLocalPlayerActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:screenOrientation="fullUser"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <receiver
            android:name="com.liskovsoft.smartyoutubetv2.tv.phone.PhoneUpdater$InstallReceiver"
            android:exported="false" />
        <!-- TV only: starts SmartTube's remote control service at boot, screen on, power connected... -->
        <receiver
            android:name="com.liskovsoft.smartyoutubetv2.common.misc.RemoteControlReceiver"
            tools:node="remove" />
        <!-- TV only: the service behind "Remote control" (this device as a cast target, found over the local network) -->
        <service
            android:name="com.liskovsoft.smartyoutubetv2.common.misc.RemoteControlService"
            tools:node="remove" />
        <!-- TV only: Android TV's home screen rows and its system-wide search -->
        <receiver
            android:name="com.liskovsoft.leanbackassistant.channels.UpdateChannelsReceiver"
            tools:node="remove" />
        <activity
            android:name="com.liskovsoft.leanbackassistant.search.SearchableActivity"
            tools:node="remove" />
        <provider
            android:name="com.liskovsoft.leanbackassistant.search.VideoContentProvider"
            tools:node="remove" />
    </application>
</manifest>
