<?xml version="1.0" encoding="utf-8"?>
<!-- The widget, large (3x3 and up): a big cover stack in the middle, the song under it, Previous, Play and Next at the bottom -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/phone_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/phone_widget_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
                android:id="@+id/phone_widget_art_box"
                android:layout_width="180dp"
                android:layout_height="180dp">

                <StackView
                    android:id="@+id/phone_widget_stack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:loopViews="false" />

                <ImageView
                    android:id="@+id/phone_widget_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@mipmap/app_icon" />
            </FrameLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/phone_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/phone_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/phone_widget_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/phone_previous"
                android:padding="11dp"
                android:src="@drawable/ic_phone_prev" />

            <FrameLayout
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/phone_widget_play_box"
                android:layout_width="60dp"
                android:layout_height="60dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/phone_widget_play_bg" />

                <ImageView
                    android:id="@+id/phone_widget_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/phone_widget_play_pause"
                    android:padding="16dp"
                    android:src="@drawable/ic_phone_play" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/phone_widget_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/phone_next"
                android:padding="11dp"
                android:src="@drawable/ic_phone_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
