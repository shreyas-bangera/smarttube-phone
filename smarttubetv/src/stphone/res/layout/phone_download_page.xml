<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/phone_download_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@id/phone_downloads_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/phone_text_2"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/phone_downloads_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:saveEnabled="false" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/phone_download_loading"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/phone_accent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/phone_download_empty_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="36dp"
            android:paddingVertical="24dp">

            <ImageView
                android:id="@+id/phone_download_empty_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/phone_download_empty_icon"
                android:importantForAccessibility="no"
                android:padding="21dp"
                android:tint="@color/phone_accent" />

            <TextView
                android:id="@+id/phone_download_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/phone_text"
                android:textSize="20sp" />

            <TextView
                android:id="@id/phone_downloads_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:maxWidth="296dp"
                android:textColor="@color/phone_text_2"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
