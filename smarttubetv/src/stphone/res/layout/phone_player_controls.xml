<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8C000000"
    android:clickable="true"
    android:focusable="false"
    android:visibility="gone">

    <ImageView
        android:id="@+id/phone_ctl_collapse"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:padding="10dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/phone_back"
        android:src="@drawable/ic_phone_collapse"
        android:tint="#FFFFFF" />

    <!-- Title, shown in full screen only -->
    <TextView
        android:id="@+id/phone_ctl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="60dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="264dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:shadowColor="#99000000"
        android:shadowRadius="4"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:orientation="horizontal">

        <!-- Live chat: shows the stream's chat again after it was closed (only for live streams) -->
        <ImageView
            android:id="@+id/phone_ctl_chat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_live_chat"
            android:src="@drawable/ic_phone_comments"
            android:tint="#FFFFFF"
            android:visibility="gone" />

        <!-- Cast: play on a TV (PhoneCast) -->
        <ImageView
            android:id="@+id/phone_ctl_cast"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_cast"
            android:src="@drawable/ic_phone_cast"
            android:tint="#FFFFFF" />

        <!-- Autoplay the next video: on/off switch (YouTube style) -->
        <ImageView
            android:id="@+id/phone_ctl_autoplay"
            android:layout_width="54dp"
            android:layout_height="48dp"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_autoplay"
            android:src="@drawable/ic_phone_autoplay_on" />

        <ImageView
            android:id="@+id/phone_ctl_pip"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_pip"
            android:src="@drawable/ic_phone_pip"
            android:tint="#FFFFFF"
            android:visibility="gone" />

        <!-- Playback mode: play next, repeat, shuffle, play the list... -->
        <ImageView
            android:id="@+id/phone_ctl_mode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_playback_mode"
            android:src="@drawable/ic_phone_mode_next" />

        <ImageView
            android:id="@+id/phone_ctl_speed"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_speed"
            android:src="@drawable/ic_phone_speed"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/phone_ctl_cc"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="11dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_captions"
            android:src="@drawable/ic_phone_cc"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/phone_ctl_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="11dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_quality"
            android:src="@drawable/ic_phone_settings"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/phone_ctl_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/phone_ctl_circle"
            android:contentDescription="@string/phone_previous"
            android:src="@drawable/ic_phone_prev"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/phone_ctl_play"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:padding="12dp"
            android:background="@drawable/phone_play_bg"
            android:contentDescription="@string/phone_play_pause"
            android:src="@drawable/ic_phone_pause"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/phone_ctl_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/phone_ctl_circle"
            android:contentDescription="@string/phone_next"
            android:src="@drawable/ic_phone_next"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/phone_ctl_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <!-- "0:42 / 4:10" on a see-through pill, as the YouTube app -->
            <TextView
                android:id="@+id/phone_ctl_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/phone_time_pill"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- Takes the row's room while the time line is the Live badge (sized to its words) -->
            <View
                android:id="@+id/phone_ctl_time_space"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/phone_ctl_fullscreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="9dp"
                android:background="@drawable/phone_ctl_circle"
                android:contentDescription="@string/phone_fullscreen"
                android:src="@drawable/ic_phone_fullscreen"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/phone_ctl_seek"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginBottom="-7dp"
            android:minHeight="3dp"
            android:maxHeight="3dp"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressBackgroundTint="#66FFFFFF"
            android:progressTint="@color/phone_accent"
            android:splitTrack="false"
            android:thumb="@drawable/phone_seek_thumb"
            android:thumbOffset="6dp" />
    </LinearLayout>
</FrameLayout>
