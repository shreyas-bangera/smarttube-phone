<?xml version="1.0" encoding="utf-8"?>
<!-- The widget, small (2x2): a big cover (a stack: swipe for the songs to come, tap one to play it) with Next and Play beside it, the song under it -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/phone_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/phone_widget_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/phone_widget_art_box"
                android:layout_width="92dp"
                android:layout_height="92dp">

                <StackView
                    android:id="@+id/phone_widget_stack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:loopViews="false" />

                <ImageView
                    android:id="@+id/phone_widget_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@mipmap/app_icon" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="end|center_horizontal"
                android:orientation="vertical">

                <ImageView
                android:id="@+id/phone_widget_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/phone_next"
                android:padding="8dp"
                android:src="@drawable/ic_phone_next" />

                <FrameLayout
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <FrameLayout
                android:id="@+id/phone_widget_play_box"
                android:layout_width="46dp"
                android:layout_height="46dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/phone_widget_play_bg" />

                <ImageView
                    android:id="@+id/phone_widget_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/phone_widget_play_pause"
                    android:padding="12dp"
                    android:src="@drawable/ic_phone_play" />
            </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/phone_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/phone_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="start"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
