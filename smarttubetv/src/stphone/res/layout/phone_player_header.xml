<?xml version="1.0" encoding="utf-8"?>
<!-- The YouTube app's details under the video: one title line, "@channel · views · date · more", then a row of
     the channel's picture, Subscribe, like | dislike and the other actions as icons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/phone_player_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:ellipsize="none"
        android:fadingEdgeLength="36dp"
        android:lineSpacingExtra="2dp"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:requiresFadingEdge="horizontal"
        android:singleLine="true"
        android:textColor="@color/phone_text"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/phone_player_meta_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="2dp">

        <!-- wraps its text: "more" sits right after it, and the text shrinks (fading) when it doesn't fit -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/phone_player_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:fadingEdgeLength="28dp"
                android:requiresFadingEdge="horizontal"
                android:singleLine="true"
                android:textColor="@color/phone_text_2"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/phone_player_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/roboto_medium"
                android:singleLine="true"
                android:text="@string/phone_more"
                android:textColor="@color/phone_text"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/phone_player_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/phone_text"
        android:textIsSelectable="true"
        android:textSize="14sp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/phone_player_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/phone_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/phone_channel" />

            <TextView
                android:id="@+id/phone_player_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/phone_button_bg"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/phone_subscribe"
                android:textColor="@color/phone_bg"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="14dp"
        android:background="@color/phone_divider" />
</LinearLayout>
