<?xml version="1.0" encoding="utf-8"?>
<!-- A page with a title and a scrolling column: Settings > Customize and Settings > What's new -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/phone_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/phone_bg"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/phone_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_back"
            android:src="@drawable/ic_phone_back"
            android:tint="@color/phone_text" />

        <TextView
            android:id="@+id/phone_screen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/phone_text"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/phone_pane_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/phone_pane_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
