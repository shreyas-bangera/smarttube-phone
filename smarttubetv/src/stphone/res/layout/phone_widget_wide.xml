<?xml version="1.0" encoding="utf-8"?>
<!-- The widget, wide (4x2 and the like): the cover stack on the left, the song and Previous, Play and Next on the right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/phone_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/phone_widget_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
                android:id="@+id/phone_widget_art_box"
                android:layout_width="120dp"
                android:layout_height="120dp">

                <StackView
                    android:id="@+id/phone_widget_stack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:loopViews="false" />

                <ImageView
                    android:id="@+id/phone_widget_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@mipmap/app_icon" />
            </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

        <TextView
            android:id="@+id/phone_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="start"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/phone_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="start"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                android:id="@+id/phone_widget_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/phone_previous"
                android:padding="9dp"
                android:src="@drawable/ic_phone_prev" />

                <FrameLayout
                android:id="@+id/phone_widget_play_box"
                android:layout_width="50dp"
                android:layout_height="50dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/phone_widget_play_bg" />

                <ImageView
                    android:id="@+id/phone_widget_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/phone_widget_play_pause"
                    android:padding="13dp"
                    android:src="@drawable/ic_phone_play" />
            </FrameLayout>

                <ImageView
                android:id="@+id/phone_widget_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/phone_next"
                android:padding="9dp"
                android:src="@drawable/ic_phone_next" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
