<?xml version="1.0" encoding="utf-8"?>
<!-- The widget, wide (4x2 and the like): the cover fills it; the song bottom left; Previous, Play and Next bottom right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/phone_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/phone_widget_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/phone_widget_title"
                android:text="@string/phone_widget_idle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"
                android:maxLines="2"
                android:shadowColor="#80000000"
                android:shadowRadius="6"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/phone_widget_artist"
                android:text="@string/phone_widget_idle_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="start"
                android:shadowColor="#80000000"
                android:shadowRadius="6"
                android:singleLine="true"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/phone_widget_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/phone_widget_glass"
            android:contentDescription="@string/phone_previous"
            android:padding="10dp"
            android:src="@drawable/ic_phone_prev" />

        <FrameLayout
            android:id="@+id/phone_widget_play_box"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/phone_widget_play_bg" />

            <ImageView
                android:id="@+id/phone_widget_play"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/phone_widget_play_pause"
                android:padding="14dp"
                android:src="@drawable/ic_phone_play" />
        </FrameLayout>

        <ImageView
            android:id="@+id/phone_widget_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/phone_widget_glass"
            android:contentDescription="@string/phone_next"
            android:padding="10dp"
            android:src="@drawable/ic_phone_next" />
    </LinearLayout>
</FrameLayout>
