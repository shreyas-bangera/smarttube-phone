+
+        fun varint(field: Int, value: Int): Proto = varint(field, value.toLong())
+
+        fun string(field: Int, value: String): Proto = apply {
+            val utf8 = value.toByteArray(Charsets.UTF_8)
+            tag(field, 2)
+            writeVarint(utf8.size.toLong())
+            bytes.write(utf8)
+        }
